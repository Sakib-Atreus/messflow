{
  "name": "messflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node --env-file=.env.local scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:reset-data": "node --env-file=.env.local scripts/reset-data.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-super-admin.mjs",
    "db:migrate:prod": "node --env-file=.env.production.local scripts/migrate.mjs",
    "admin:create:prod": "node --env-file=.env.production.local scripts/create-super-admin.mjs",
    "db:backup": "node --env-file=.env.production.local scripts/backup.mjs live",
    "db:backup:dev": "node --env-file=.env.local scripts/backup.mjs dev",
    "db:restore": "node --env-file=.env.local scripts/restore.mjs",
    "db:restore:prod": "node --env-file=.env.production.local scripts/restore.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "next-intl": "^4.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "playwright": "1.65.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
